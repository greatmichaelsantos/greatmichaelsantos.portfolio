---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer reveal">
  <span>
    © {year} {site.name}
  </span>
  <a class="to-top" href="#top">
    Back to top <span aria-hidden="true">↑</span>
  </a>
  <span>Built by hand. Black &amp; white on purpose.</span>
</footer>

<style>
  .site-footer {
    max-width: 1060px;
    margin: 0 auto;
    padding: 32px 24px 48px;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    color: var(--dim);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--rule);
    color: var(--fg);
    text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .to-top:hover {
      background: var(--fg);
      color: var(--bg);
    }
  }
  /* Nothing to scroll back to (set by the script below). visibility keeps the
     footer's layout steady and also takes the link out of the tab order. */
  .to-top[data-idle] {
    visibility: hidden;
  }
  @media (max-width: 640px) {
    .site-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  // When the whole page fits on screen (e.g. the 404 page on a laptop), "Back to
  // top" can't do anything, so hide it until the page is tall enough to scroll.
  // Without JS it always shows, and it still works as a plain #top link.
  const toTop = document.querySelector<HTMLElement>('.to-top');
  if (toTop) {
    const root = document.documentElement;
    const update = () => toTop.toggleAttribute('data-idle', root.scrollHeight <= root.clientHeight);
    update();
    new ResizeObserver(update).observe(document.body);
    window.addEventListener('resize', update);
  }
</script>
