---
import { site } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---

<section id="about" class="reveal" aria-labelledby="about-h">
  <SectionHeading id="about-h" index="02" title="About" />
  <div class="about-body">
    <p>{site.about}</p>
  </div>
</section>

<style>
  .about-body {
    max-width: 58ch;
    font-size: clamp(16px, 2vw, 20px);
    line-height: 1.8;
  }
</style>
