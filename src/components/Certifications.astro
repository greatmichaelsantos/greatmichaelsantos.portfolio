---
import { certificateGroups } from '../data/certifications';
import { url } from '../lib/url';
import ExternalLink from './ExternalLink.astro';
import SectionHeading from './SectionHeading.astro';
---

<section id="certs" class="reveal" aria-labelledby="certs-h">
  <SectionHeading id="certs-h" index="04" title="Certifications" />
  {certificateGroups.map((group) => (
    <div class="group">
      <h3>{group.issuer}</h3>
      <ul class="chips">
        {group.certificates.map((cert) => (
          <li>
            {cert.file ? (
              <ExternalLink
                href={url(`certs/${cert.file}`)}
                data-cert={cert.title ?? `${group.issuer} ${cert.label}`}
                data-cert-alt={cert.alt}
                note={
                  cert.graphic ? '(image, opens in a new tab)' : '(certificate image, opens in a new tab)'
                }
              >
                {cert.label}
              </ExternalLink>
            ) : (
              cert.label
            )}
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>
