---
import { navLinks, type PageKey } from '../data/navigation';
import { site } from '../data/site';
import { url } from '../lib/url';

interface Props {
  page: PageKey;
}
const { page } = Astro.props;
---

<header class="site-nav">
  <nav class="site-nav__inner" aria-label="Main">
    <a class="site-nav__brand" href={url('')}>
      {site.name}
    </a>
    <button class="site-nav__toggle" type="button" aria-expanded="false" aria-controls="site-nav-list">
      Menu
    </button>
    <ul class="site-nav__list" id="site-nav-list">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} aria-current={link.page && link.page === page ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(0, 0, 0, 0.86);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--rule);
    /* Captured on its own during page transitions, so it stays put while the
       page underneath wipes in. */
    view-transition-name: site-nav;
  }
  .site-nav__inner {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 24px;
    min-height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    position: relative;
  }
  .site-nav__brand {
    font-family: var(--grotesque);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .site-nav__list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .site-nav__list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--dim);
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }
  .site-nav__list a[aria-current='page'] {
    color: var(--fg);
  }
  @media (hover: hover) and (pointer: fine) {
    .site-nav__list a:hover {
      color: var(--fg);
    }
    .site-nav__toggle:hover {
      background: var(--fg);
      color: var(--bg);
    }
  }
  .site-nav__list a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 6px;
  }

  /* The toggle only exists when JS can drive it. */
  .site-nav__toggle {
    display: none;
    min-height: 44px;
    min-width: 44px;
    padding: 0 16px;
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--fg);
    font: inherit;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-meta);
    text-transform: uppercase;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .site-nav__inner {
      padding: 0 16px;
      flex-wrap: wrap;
    }
    /* No JS: links simply wrap under the brand. */
    .site-nav__list {
      width: 100%;
      padding-bottom: 8px;
    }
    .site-nav__list a {
      padding: 0 8px;
    }

    /* With JS: collapse into a toggle menu. */
    :global(.js) .site-nav__inner {
      flex-wrap: nowrap;
    }
    :global(.js) .site-nav__toggle {
      display: inline-flex;
      align-items: center;
    }
    :global(.js) .site-nav__list {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 8px 16px 16px;
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
    }
    :global(.js) .site-nav__list[data-open] {
      display: flex;
    }
    :global(.js) .site-nav__list a {
      width: 100%;
      min-height: 48px;
      color: var(--fg);
      border-bottom: 1px solid var(--rule);
    }
    :global(.js) .site-nav__list li:last-child a {
      border-bottom: 0;
    }
  }

  @media (max-width: 380px) {
    .site-nav__brand {
      font-size: var(--text-label);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-nav__toggle');
  const list = document.getElementById('site-nav-list');
  const nav = document.querySelector<HTMLElement>('.site-nav__inner');

  if (toggle && list && nav) {
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const setOpen = (open: boolean, returnFocus = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? 'Close' : 'Menu';
      if (open) list.setAttribute('data-open', '');
      else list.removeAttribute('data-open');
      if (!open && returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(!isOpen()));

    // Esc closes and hands focus back to the toggle.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) setOpen(false, true);
    });

    // Choosing a link closes the menu.
    list.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });

    // Tabbing or clicking outside the nav closes it.
    nav.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (isOpen() && next && !nav.contains(next)) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && !nav.contains(e.target as Node)) setOpen(false);
    });

    // Back to the desktop layout: reset state.
    window.matchMedia('(min-width: 901px)').addEventListener('change', (mq) => {
      if (mq.matches) setOpen(false);
    });
  }
</script>
